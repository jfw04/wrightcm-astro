---
/**
 * Shared editorial project-detail template.
 * Driven entirely by a JSON record in src/data/projects/.
 * Adding a project = add one JSON file + its optimized images. No template edits.
 */
import FinalCta from './FinalCta.astro';
import ProjectFigure from './ProjectFigure.astro';

const { p, related = [] } = Astro.props;
const dir = p.imageDir;
---
<article class="pdx">
  <!-- HERO -->
  <section class="pdx-hero">
    <picture class="pdx-hero-bg">
      <source
        type="image/webp"
        srcset={`/${dir}/${p.hero.key}-1024.webp 1024w, /${dir}/${p.hero.key}-1600.webp 1600w`}
        sizes="100vw"
      />
      <img
        src={`/${dir}/${p.hero.key}-1600.jpg`}
        srcset={`/${dir}/${p.hero.key}-1024.jpg 1024w, /${dir}/${p.hero.key}-1600.jpg 1600w`}
        sizes="100vw"
        alt={p.hero.alt}
        width={p.hero.w}
        height={p.hero.h}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
    <div class="wrap pdx-hero-inner">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/projects">Projects</a> / {p.name}
      </div>
      <div class="pdx-eyebrow">{p.eyebrow}</div>
      <h1>{p.name}</h1>
      <div class="pdx-loc">{p.location}</div>
      {p.heroStats?.length > 0 && (
        <div class="pdx-hero-stats">
          {p.heroStats.map((s) => (
            <div><span>{s.label}</span><strong>{s.value}</strong></div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- BODY -->
  <section class="pdx-main">
    <div class="wrap">
      <div class="pdx-layout">
        <div class="pdx-body">
          {p.overview?.map((t, i) => (
            <p class={i === 0 ? 'pdx-lead' : undefined}>{t}</p>
          ))}

          {p.blocks?.map((b) => {
            if (b.type === 'section') {
              return (
                <div class="pdx-section">
                  {b.heading && <h2>{b.heading}</h2>}
                  {b.paragraphs?.map((t) => <p>{t}</p>)}
                </div>
              );
            }
            if (b.type === 'figure') {
              return (
                <ProjectFigure
                  dir={dir}
                  imgKey={b.key}
                  w={b.w}
                  h={b.h}
                  alt={b.alt}
                  caption={b.caption}
                  className="pdx-fig-wide"
                  sizes="(max-width: 980px) 100vw, 780px"
                />
              );
            }
            if (b.type === 'pair') {
              // Column widths proportional to each image's aspect ratio, so a
              // portrait and a landscape shot render at the same height.
              const cols = b.items
                .map((it) => `${(it.w && it.h ? it.w / it.h : 4 / 3).toFixed(4)}fr`)
                .join(' ');
              return (
                <div class="pdx-pair" style={`grid-template-columns:${cols}`}>
                  {b.items.map((it) => (
                    <ProjectFigure
                      dir={dir}
                      imgKey={it.key}
                      w={it.w}
                      h={it.h}
                      alt={it.alt}
                      caption={it.caption}
                      sizes="(max-width: 700px) 100vw, 380px"
                      widths={[640, 1024]}
                    />
                  ))}
                </div>
              );
            }
            return null;
          })}
        </div>

        <aside class="pdx-facts">
          <h2>Project Details</h2>
          {p.tags?.length > 0 && (
            <div class="pdx-tags">
              {p.tags.map((t) => (
                <a class="pdx-tag" href={`/projects?filter=${encodeURIComponent(t)}`}>{t}</a>
              ))}
            </div>
          )}
          <dl>
            {p.facts?.map((f) => (
              <div class="row"><dt>{f.label}</dt><dd>{f.value}</dd></div>
            ))}
          </dl>
          <a href="/contact" class="btn btn-primary">Schedule a Call</a>
        </aside>
      </div>
    </div>
  </section>

  {p.gallery?.length > 0 && (
    <section class="section-soft pdx-gallery-sec">
      <div class="wrap">
        <span class="eyebrow">Project Gallery</span>
        <h2 class="section-title">{p.galleryHeading || `More from ${p.name}`}</h2>
        <div class="pdx-gallery">
          {p.gallery.map((g) => (
            <ProjectFigure
              dir={dir}
              imgKey={g.key}
              w={g.w}
              h={g.h}
              alt={g.alt}
              caption={g.caption}
              sizes="(max-width: 700px) 100vw, (max-width: 980px) 50vw, 380px"
              widths={[640, 1024]}
              zoomable={true}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="pdx-related-sec">
      <div class="wrap">
        <span class="eyebrow">Related Work</span>
        <h2 class="section-title">Similar Projects</h2>
        <div class="pdx-related">
          {related.map((r) => (
            <a class="pdx-rel" href={`/projects/${r.slug}`}>
              <div class="ph">
                <img src={`/${r.imageDir}/card-900.jpg`} alt={r.name} loading="lazy" width="900" height="600" />
              </div>
              <div class="body">
                <span class="type">{r.eyebrow}</span>
                <h3>{r.name}</h3>
                <div class="loc">{r.location}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <FinalCta heading={p.cta.heading} sub={p.cta.sub} />

  <!-- Click-to-enlarge lightbox for the project gallery -->
  <div class="pdx-lb" id="pdxLb" hidden role="dialog" aria-modal="true" aria-label="Project photo viewer">
    <button type="button" class="pdx-lb-close" data-lb="close" aria-label="Close photo viewer">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <button type="button" class="pdx-lb-nav prev" data-lb="prev" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <figure class="pdx-lb-stage">
      <img id="pdxLbImg" src="" alt="" />
      <figcaption><span id="pdxLbCap"></span><span class="pdx-lb-count" id="pdxLbCount"></span></figcaption>
    </figure>
    <button type="button" class="pdx-lb-nav next" data-lb="next" aria-label="Next photo">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>

  <script is:inline>
    (function () {
      var lb = document.getElementById('pdxLb');
      if (!lb) return;
      var figs = [].slice.call(document.querySelectorAll('.pdx-fig[data-zoom]'));
      if (!figs.length) return;

      var img = document.getElementById('pdxLbImg');
      var cap = document.getElementById('pdxLbCap');
      var count = document.getElementById('pdxLbCount');
      var i = 0, opener = null;
      var multi = figs.length > 1;
      lb.querySelectorAll('.pdx-lb-nav').forEach(function (b) { b.hidden = !multi; });

      function show(n) {
        i = (n + figs.length) % figs.length;
        var f = figs[i];
        var src = f.getAttribute('data-full');
        var thumb = f.querySelector('img');
        img.src = src;
        img.alt = thumb ? thumb.alt : '';
        cap.textContent = thumb ? thumb.alt : '';
        count.textContent = multi ? (i + 1) + ' / ' + figs.length : '';
      }
      function open(n, from) {
        opener = from || null;
        show(n);
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
        lb.querySelector('.pdx-lb-close').focus();
      }
      function close() {
        lb.hidden = true;
        img.src = '';
        document.body.style.overflow = '';
        if (opener) opener.focus();
      }

      figs.forEach(function (f, n) {
        var btn = f.querySelector('.pdx-zoom');
        if (btn) btn.addEventListener('click', function () { open(n, btn); });
      });

      lb.addEventListener('click', function (e) {
        var act = e.target.closest ? e.target.closest('[data-lb]') : null;
        if (act) {
          var a = act.getAttribute('data-lb');
          if (a === 'close') close();
          if (a === 'prev') show(i - 1);
          if (a === 'next') show(i + 1);
          return;
        }
        // click the backdrop (not the photo) to dismiss
        if (!e.target.closest('.pdx-lb-stage')) close();
      });

      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (multi && e.key === 'ArrowLeft') show(i - 1);
        else if (multi && e.key === 'ArrowRight') show(i + 1);
        else if (e.key === 'Tab') {
          // keep focus inside the dialog while it is open
          var f = lb.querySelectorAll('button:not([hidden])');
          var first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
    })();
  </script>
</article>
