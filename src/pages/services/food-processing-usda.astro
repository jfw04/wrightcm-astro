        <tr><th scope="row"><span class="cn-full">Builds Around Live Production</span><span class="cn-short">Builds Around Live Production</span></th><td class="us"><span class="mk mk-y">&#10003;</span></td><td class=""><span class="mk mk-y">&#10003;</span></td><td class=""><span class="mk mk-n">&#10005;</span></td></tr>
        <tr><th scope="row"><span class="cn-full">Same Team From Concept Through Closeout</span><span class="cn-short">Same Team, Concept To Closeout</span></th><td class="us"><span class="mk mk-y">&#10003;</span></td><td class=""><span class="mk mk-n">&#10005;</span></td><td class=""><span class="mk mk-n">&#10005;</span></td></tr>
