<Base title={title} description={description}>
  <div class="ilp" set:html={bodyHtml}></div>
  <script is:inline>
(function(){
  var ids = ['rev','marg','cap','rate','sf','fte'];
  var HOURS = 173.3, WAGE = 27, LABOR_FACTOR = 0.48, PSF = 4.40;

  function money(n){ return '$' + Math.round(n).toLocaleString('en-US'); }
  function num(id){
    var v = parseFloat(document.getElementById(id).value);
    return isNaN(v) ? 0 : v;
  }
  function calc(){
    var margin  = num('rev') * (num('marg')/100);
    var carry   = num('cap') * (num('rate')/100) / 12;
    var idle    = num('sf') * PSF / 12;
    var labor   = num('fte') * WAGE * HOURS * LABOR_FACTOR;
    var total   = margin + carry + idle + labor;

    document.getElementById('o1').textContent = money(margin);
    document.getElementById('o2').textContent = money(carry);
    document.getElementById('o3').textContent = money(idle);
    document.getElementById('o4').textContent = money(labor);
    document.getElementById('total').textContent = money(total);
    document.getElementById('late').textContent  = money(total * 2);
    document.getElementById('swing').textContent = money(total * 4);
  }
  ids.forEach(function(id){
    document.getElementById(id).addEventListener('input', calc);
  });
  calc();
})();
  </script>
