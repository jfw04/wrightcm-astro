---
import Base from '../../layouts/Base.astro';
import FinalCta from '../../components/FinalCta.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import data from '../../data/content.json';

/**
 * Two kinds of project pages live here:
 *  1. Editorial pages — one JSON record per project in src/data/projects/.
 *     These are the Airtable-approved case studies. Rendered by ProjectDetail.astro.
 *  2. Legacy card pages — entries in content.json that do not yet have an
 *     editorial record. Rendered with the original simple layout.
 * When an editorial record exists for a slug, it always wins.
 */
const editorialModules = import.meta.glob('../../data/projects/*.json', { eager: true });
const editorial = Object.values(editorialModules).map((m: any) => m.default ?? m);
const editorialBySlug = Object.fromEntries(editorial.map((e) => [e.slug, e]));

export function getStaticPaths() {
  const mods = import.meta.glob('../../data/projects/*.json', { eager: true });
  const eds = Object.values(mods).map((m: any) => m.default ?? m);
  const edSlugs = new Set(eds.map((e) => e.slug));

  const editorialPaths = eds.map((e) => ({
    params: { slug: e.slug },
    props: { mode: 'editorial', e },
  }));

  const legacyPaths = data.projects
    .filter((p) => !edSlugs.has(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { mode: 'legacy', p } }));

  return [...editorialPaths, ...legacyPaths];
}

const { mode, e, p } = Astro.props;

// --- editorial ---------------------------------------------------------
let related = [];
if (mode === 'editorial') {
  related = (e.related || [])
    .map((s: string) => editorialBySlug[s])
    .filter(Boolean);
}

const site = 'https://wrightcm.co';
const canonical =
  mode === 'editorial'
    ? `${site}/projects/${e.slug}`
    : `${site}/projects/${p.slug}`;

const title =
  mode === 'editorial'
    ? e.seo?.title || `${e.name} | Wright Construction Management`
    : `${p.name} | Wright Construction Management`;

const description =
  mode === 'editorial'
    ? e.seo?.description
    : p.summary.slice(0, 155);

const ogImage =
  mode === 'editorial'
    ? `${site}/${e.seo?.ogImage || `${e.imageDir}/og.jpg`}`
    : `${site}/${p.cover}`;

const breadcrumbLd =
  mode === 'editorial'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
          { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site}/projects` },
          { '@type': 'ListItem', position: 3, name: e.name, item: canonical },
        ],
      }
    : null;

// --- legacy ------------------------------------------------------------
const rows = [
  ['Sector', 'sector'], ['Location', 'location'], ['Client / Owner', 'client'],
  ['Project Type', 'type'], ['Construction Value', 'value'], ['Size', 'size'],
  ['Completed', 'completion'], ['Schedule', 'schedule'],
];
---
<Base
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  jsonLd={breadcrumbLd}
>
  {mode === 'editorial' ? (
    <ProjectDetail p={e} related={related} />
  ) : (
    <>
      <section class="pd-hero"><img class="bg" src={`/${p.cover}`} alt="" />
        <div class="wrap inner">
          <div class="breadcrumb"><a href="/">Home</a> / <a href="/projects">Projects</a> / {p.name}</div>
          <div class="type">{p.type}</div><h1>{p.name}</h1><div class="loc">{p.location}</div>
        </div>
      </section>
      <section><div class="wrap"><div class="pd-layout">
        <div class="pd-body">
          <h2>Overview</h2><p>{p.summary}</p>
          <h2>Challenges</h2><p>{p.challenges}</p>
          <h2>Wright CM's Role</h2><p>{p.role}</p>
          <h2>Outcome</h2><p>{p.outcome}</p>
          <div class="gallery">{(p.gallery || []).map((g) => (<img src={`/${g}`} alt={p.name} loading="lazy" />))}</div>
        </div>
        <aside class="pd-facts"><h3>Project Facts</h3>
          {rows.map(([label, key]) => (<div class="row"><span>{label}</span><strong>{p[key] || '—'}</strong></div>))}
          <a href="/contact" class="btn btn-primary">Start a Project Like This</a>
        </aside>
      </div></div></section>
      <FinalCta heading="Have a project with constraints like these?" sub="Book a 15-minute feasibility call and we'll surface the biggest cost, schedule, and operational risks early." />
    </>
  )}
</Base>
